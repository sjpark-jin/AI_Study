# ==============================================================================
# Week 06 환경변수 설정 템플릿 (.env.example)
# ==============================================================================

# LLM Provider 설정 (기본값: mock / openai)
DEFAULT_LLM_PROVIDER=mock

# OpenAI API Key (선택: 실제 모델 연동 시 입력)
OPENAI_API_KEY=

# RAG & 검색 가중치 설정 (RRF 및 임계값)
DENSE_TOP_K=4
BM25_TOP_K=4
RERANK_TOP_K=3
RRF_K=60

# RAG 평가 임계값 (0~100)
FAITHFULNESS_THRESHOLD=80
ANSWER_RELEVANCE_THRESHOLD=80
CONTEXT_PRECISION_THRESHOLD=75
