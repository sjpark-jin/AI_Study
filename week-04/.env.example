# ==========================================
# AI Study 환경변수 설정 파일 (.env)
# 필요 시 각 서비스에서 발급받은 API 키를 채워넣으세요.
# ==========================================

# 기본 LLM Provider 선택 (mock / openai / anthropic / gemini / ollama)
DEFAULT_LLM_PROVIDER=mock

# 1. OpenAI API Key (GPT-3.5, GPT-4, GPT-4o 등)
OPENAI_API_KEY=

# 2. Anthropic API Key (Claude 3.5 Sonnet, Claude 3 Opus 등)
ANTHROPIC_API_KEY=

# 3. Google Gemini API Key
GEMINI_API_KEY=
GOOGLE_API_KEY=

# 4. Cohere API Key (Rerank 모델 및 Embeddings 지원)
COHERE_API_KEY=

# 5. Groq API Key (초고속 Llama/Mixtral 추론)
GROQ_API_KEY=

# 6. Local Ollama Base URL
OLLAMA_BASE_URL=http://localhost:11434

# 7. Vector DB & Search API Keys
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# 8. Web Search Tools (Agent용 웹 검색 API)
TAVILY_API_KEY=
SERPER_API_KEY=

# 9. LLM Monitoring & Tracing (LangChain / LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=
