# ==============================================================================
# Week 07 환경변수 설정 템플릿 (.env.example)
# ==============================================================================

# TypeSafe AI Jev Provider 설정 (기본값: mock / typesafe)
# 실제 TypeSafe AI SDK 연동 시 'typesafe'로 변경하고 TYPESAFE_API_KEY를 입력하세요.
DEFAULT_JEV_PROVIDER=mock

# TypeSafe AI API Key (선택: 실제 Jev 모델 호출 시 입력)
TYPESAFE_API_KEY=

# TypeSafe Jev 모델 버전 (기본값: jev-latest)
JEV_MODEL=jev-latest

# System 2 (생성형 LLM) Provider 설정 (기본값: mock / openai)
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=

# 확률적 의사결정 임계값 (Confidence & Probability Guardrails)
AUTO_ROUTE_CONFIDENCE_THRESHOLD=0.75
URGENCY_ESCALATION_SCORE_THRESHOLD=1.80
SECURITY_RISK_NOUL_THRESHOLD=0.65
REFUND_APPROVAL_NOUL_THRESHOLD=0.70

