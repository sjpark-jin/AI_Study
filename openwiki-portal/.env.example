# ==============================================================================
# OpenWiki Wikipedia Portal 환경변수 (.env.example)
# ==============================================================================

# 로컬 OpenWiki 마크다운 폴더 경로 (기본값: ./openwiki)
WIKI_DIR=./openwiki

# GitHub 저장소 실시간 동기화 설정 (선택 사항)
# 예: owner/repo 형태 (예: langchain-ai/openwiki)
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_WIKI_PATH=openwiki
# Private 레포지토리이거나 API Rate Limit 확장을 원할 경우 GitHub PAT 입력
GITHUB_TOKEN=

# 서버 포트 (AWS EC2 배포 시 기본 8000, Nginx 리버스 프록시 연동)
PORT=8000

