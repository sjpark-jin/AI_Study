[Unit]
Description=OpenWiki Wikipedia Portal (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/openwiki-portal
Environment="PATH=/opt/openwiki-portal/venv/bin"
ExecStart=/opt/openwiki-portal/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

